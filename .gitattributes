# Normalize text files, keep Windows launchers CRLF.
* text=auto eol=lf

*.ps1 text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.js text eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf

*.exe binary
*.dll binary
*.zip binary
*.7z binary
*.png binary
*.jpg binary
*.ico binary
